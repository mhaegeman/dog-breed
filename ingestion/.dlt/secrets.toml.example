# ──────────────────────────────────────────────────────────────
# Copy this file to secrets.toml and fill in real values.
# NEVER commit secrets.toml — it is git-ignored.
# In Cloud Functions, use environment variables instead.
# ──────────────────────────────────────────────────────────────

[sources.dog_api]
api_key = "your-dog-api-key-here"

# GCP credentials — shared by both BigQuery and Cloud Storage destinations.
# When running on GCP (Cloud Functions), Application Default Credentials
# are used automatically and this section can be omitted.
[destination.credentials]
project_id = "your-gcp-project-id"
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
client_email = "your-sa@your-project.iam.gserviceaccount.com"
